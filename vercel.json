{
  "buildCommand": "",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/ranking-vpn",
      "destination": "/porownanie-vpn",
      "permanent": true
    },
    {
      "source": "/ranking",
      "destination": "/porownanie-vpn",
      "permanent": true
    },
    {
      "source": "/vpn",
      "destination": "/porownanie-vpn",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/kick",
      "schedule": "5 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/odznaka/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=1800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}